---
// Pantalla de carga animada de JDT: solo al abrir la app (una vez por pestaña), no al cambiar de pantalla.
// Animación: tres gotas de resina (rojo, amarillo, azul) caen, salpican y se vuelven los cuadros J · D · T;
// luego un brillo pasa encima (se repite mientras carga), destella escarcha y aparece la frase. Solo código, sin video.
// Tiempo fijo: la animación arranca cuando la pantalla ya se ve y la letra gruesa está lista (máx. 0,7 s de espera),
// no al tocar el enlace; así nunca se corta a la mitad aunque la página tarde en llegar.
// Se ve completa (2,3 s desde que arranca) y se va apenas la página está lista (máximo 4,5 s desde que arranca).
// Solo se animan movimiento y transparencia (no formas), para que no se trabe aunque el celular esté ocupado cargando.
// Que ya se vio lo marca BaseHead antes de pintar (<html data-splash-seen>), así no aparece ni un instante.
const tiles = [
  { letter: "J", c1: "#ff6b7a", c2: "#ec2a41" },
  { letter: "D", c1: "#ffd34d", c2: "#f0a800" },
  { letter: "T", c1: "#35a8df", c2: "#0071a8" },
];
const sparks = [
  { x: "-6%", y: "-14%", d: "1.35s", s: "16px" },
  { x: "104%", y: "6%", d: "1.5s", s: "12px" },
  { x: "36%", y: "-22%", d: "1.62s", s: "10px" },
  { x: "88%", y: "96%", d: "1.45s", s: "14px" },
  { x: "-2%", y: "88%", d: "1.7s", s: "9px" },
];
---

<div class="splash" id="splash" aria-hidden="true">
  <div class="splash-logo">
    {
      tiles.map((t, i) => (
        <span class="splash-cell" style={`--i:${i};--c1:${t.c1};--c2:${t.c2}`}>
          <span class="splash-drop" />
          <span class="splash-tile">
            <b>{t.letter}</b>
          </span>
        </span>
      ))
    }
    {sparks.map((s) => <i class="splash-spark" style={`--x:${s.x};--y:${s.y};--d:${s.d};--s:${s.s}`} />)}
  </div>
  <p class="splash-tag">
    <span>Juega</span><i></i><span>Decora</span><i></i><span>Trabaja</span>
  </p>
  <small class="splash-sub">Porcelanato Líquido 3D</small>
  <span class="splash-bar"><span></span></span>
</div>

<script is:inline>
  (() => {
    const el = document.getElementById("splash");
    if (!el) return;
    if ("splashSeen" in document.documentElement.dataset) return el.remove();
    try {
      sessionStorage.setItem("jdt-splash", "1");
    } catch {}
    const MIN = 2300, MAX = 4500;
    let started = false, done = false;

    const hide = () => {
      if (done) return;
      done = true;
      el.classList.add("leaving");
      el.addEventListener("transitionend", () => el.remove(), { once: true });
      setTimeout(() => el.remove(), 700);
    };

    // Terminó la animación: salir ya si la página cargó; si no, al cargar (o al llegar al máximo)
    const afterMin = () => {
      if (document.readyState === "complete") return hide();
      addEventListener("load", hide, { once: true });
      setTimeout(hide, MAX - MIN);
    };

    const start = () => {
      if (started) return;
      started = true;
      el.classList.add("go");
      setTimeout(afterMin, MIN);
    };

    // Arranca con la letra gruesa lista (sin saltos de tamaño) y en el siguiente cuadro pintado
    const wait = (ms) => new Promise((r) => setTimeout(r, ms));
    const font = document.fonts && document.fonts.load ? document.fonts.load('800 64px "Montserrat"').catch(() => {}) : null;
    Promise.race([font || Promise.resolve(), wait(700)]).then(() => requestAnimationFrame(start));
    // Respaldo (pestaña en segundo plano: no pinta cuadros)
    setTimeout(start, 1000);
  })();
</script>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-toast) + 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    overflow: hidden;
    background-color: var(--clr-bg);
    transition: opacity 0.4s var(--ease), visibility 0.4s;
  }

  :global(:root[data-splash-seen]) .splash {
    display: none;
  }

  /* Quieta (en blanco) hasta que el script da la señal: así siempre se ve completa desde el inicio */
  .splash:not(.go) *,
  .splash:not(.go) *::before,
  .splash:not(.go) *::after {
    animation-play-state: paused;
  }

  .splash.leaving {
    opacity: 0;
    visibility: hidden;
  }

  .splash.leaving .splash-logo {
    transform: scale(1.06);
  }

  /* Los tres cuadros del logo */
  .splash-logo {
    position: relative;
    display: flex;
    gap: 8px;
    margin-bottom: var(--space-2);
    transition: transform 0.4s var(--ease);
  }

  .splash-cell {
    position: relative;
    display: block;
    width: 76px;
    height: 92px;
  }

  /* Gota de resina que cae */
  .splash-drop {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 22px;
    height: 30px;
    margin-left: -11px;
    border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
    background: linear-gradient(160deg, var(--c1), var(--c2));
    opacity: 0;
    animation: splashFall 0.42s calc(var(--i) * 0.13s) cubic-bezier(0.55, 0, 1, 0.45) both;
  }

  /* Ola que se abre al caer la gota */
  .splash-cell::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 120px;
    height: 16px;
    margin-left: -60px;
    border: 2px solid var(--c2);
    border-radius: 50%;
    opacity: 0;
    animation: splashRipple 0.7s calc(0.4s + var(--i) * 0.13s) var(--ease) forwards;
  }

  /* Gotitas que saltan con el golpe */
  .splash-cell::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 4px;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background-color: var(--c2);
    box-shadow:
      -26px 6px 0 -1px var(--c2),
      24px 2px 0 0 var(--c2),
      40px 10px 0 -2px var(--c2),
      -40px 12px 0 -2px var(--c2);
    opacity: 0;
    animation: splashDrops 0.6s calc(0.42s + var(--i) * 0.13s) cubic-bezier(0.2, 0.6, 0.4, 1) forwards;
  }

  /* La gota aplastada crece y se vuelve cuadro */
  .splash-tile {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 14px;
    background: linear-gradient(160deg, var(--c1), var(--c2));
    box-shadow:
      inset 0 -6px 0 rgb(0 0 0 / 0.12),
      0 12px 22px -10px var(--c2);
    transform-origin: 50% 100%;
    animation: splashGrow 0.55s calc(0.4s + var(--i) * 0.13s) both;
  }

  /* Brillo fijo de resina arriba */
  .splash-tile::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(170deg, rgb(255 255 255 / 0.38) 0 20%, transparent 46%);
    pointer-events: none;
  }

  /* Destello que cruza los cuadros; se repite cada 1,9 s mientras la app sigue cargando */
  .splash-tile::before {
    content: "";
    position: absolute;
    top: -20%;
    bottom: -20%;
    left: -60%;
    width: 45%;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.7), transparent);
    transform: skewX(-20deg);
    animation: splashShine 1.9s calc(1.2s + var(--i) * 0.08s) ease-in-out infinite both;
  }

  .splash-tile b {
    position: relative;
    z-index: 1;
    font-size: 64px;
    font-weight: 800;
    line-height: 1;
    color: #fff;
    text-shadow: 3px 3px 0 rgb(0 0 0 / 0.18);
    transform: skewX(-9deg);
    animation: splashLetter 0.55s calc(0.62s + var(--i) * 0.13s) cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  /* Escarcha dorada */
  .splash-spark {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    background-color: #f0b400;
    clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%);
    opacity: 0;
    animation: splashSpark 0.9s var(--d) var(--ease) both;
  }

  /* Juega • Decora • Trabaja */
  .splash-tag {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 1.05rem;
    font-weight: 800;
    white-space: nowrap;
    letter-spacing: 0.02em;
    color: var(--clr-text);
  }

  .splash-tag span,
  .splash-tag i {
    animation: splashIn 0.45s var(--ease) both;
  }

  .splash-tag span {
    transform: skewX(-9deg);
  }

  .splash-tag i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #ec2a41;
  }

  .splash-tag i:nth-of-type(2) {
    background-color: #0071a8;
  }

  .splash-tag :nth-child(1) { animation-delay: 1.15s; }
  .splash-tag :nth-child(2) { animation-delay: 1.25s; }
  .splash-tag :nth-child(3) { animation-delay: 1.32s; }
  .splash-tag :nth-child(4) { animation-delay: 1.42s; }
  .splash-tag :nth-child(5) { animation-delay: 1.49s; }

  .splash-sub {
    margin-top: calc(var(--space-3) * -1);
    font-size: var(--text-xs, 0.75rem);
    font-weight: 600;
    white-space: nowrap;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--clr-text-muted);
    animation: splashIn 0.5s 1.6s var(--ease) both;
  }

  /* Barra fina que corre de lado a lado mientras carga */
  .splash-bar {
    position: relative;
    width: 144px;
    height: 3px;
    margin-top: var(--space-2);
    overflow: hidden;
    border-radius: var(--radius-pill);
    background-color: var(--clr-border);
    animation: splashFade 0.4s 1.7s both;
  }

  .splash-bar span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 40%;
    border-radius: inherit;
    background-color: var(--clr-primary);
    animation: splashBar 1s var(--ease) infinite;
  }

  /* Gota: cae estirada desde arriba y desaparece al tocar el piso */
  @keyframes splashFall {
    0% {
      opacity: 1;
      transform: translateY(-60vh) scaleY(1.3);
    }
    92% {
      opacity: 1;
      transform: translateY(0) scaleY(1.35);
    }
    100% {
      opacity: 0;
      transform: translateY(0) scale(1.5, 0.6);
    }
  }

  /* Cuadro: nace aplastado (la gota que se esparce), se estira de más y se acomoda */
  @keyframes splashGrow {
    0% {
      opacity: 0;
      transform: scale(0.45, 0.1);
    }
    8% {
      opacity: 1;
    }
    40% {
      transform: scale(1.1, 0.9);
    }
    70% {
      transform: scale(0.97, 1.04);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes splashRipple {
    0% {
      opacity: 0.8;
      transform: scale(0.2);
    }
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  @keyframes splashDrops {
    0% {
      opacity: 1;
      transform: translateY(0) scale(0.6);
    }
    100% {
      opacity: 0;
      transform: translateY(-34px) scale(1.1);
    }
  }

  @keyframes splashLetter {
    from {
      opacity: 0;
      transform: skewX(-9deg) translateY(12px) rotate(-14deg) scale(0.2);
    }
  }

  @keyframes splashShine {
    0% {
      transform: translateX(0) skewX(-20deg);
    }
    40%,
    100% {
      transform: translateX(420%) skewX(-20deg);
    }
  }

  @keyframes splashSpark {
    0% {
      opacity: 0;
      transform: scale(0) rotate(0);
    }
    50% {
      opacity: 1;
      transform: scale(1) rotate(90deg);
    }
    100% {
      opacity: 0;
      transform: scale(0) rotate(180deg);
    }
  }

  @keyframes splashIn {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }

  @keyframes splashFade {
    from {
      opacity: 0;
    }
  }

  @keyframes splashBar {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(250%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash *,
    .splash *::before,
    .splash *::after {
      animation: none !important;
    }

    .splash-drop,
    .splash-cell::before,
    .splash-cell::after,
    .splash-spark {
      display: none;
    }

    .splash-bar span {
      animation: splashBar 2s var(--ease) infinite !important;
    }
  }
</style>
