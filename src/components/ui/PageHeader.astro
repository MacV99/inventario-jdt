---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<header>
  <div class="text">
    <h1>{title}</h1>
    {subtitle && <p class="muted" data-page-subtitle>{subtitle}</p>}
  </div>
  <div class="actions">
    <slot name="actions" />
  </div>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .text {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: var(--space-3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
</style>
