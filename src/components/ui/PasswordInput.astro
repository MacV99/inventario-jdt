---
// Contraseña con botón mostrar/ocultar (lib/ui/password.ts, delegado global).
interface Props {
  id: string;
  name: string;
  autocomplete: "current-password" | "new-password";
  placeholder?: string;
}

const { id, name, autocomplete, placeholder } = Astro.props;
---

<div class="input-password">
  <input id={id} name={name} class="input" type="password" autocomplete={autocomplete} placeholder={placeholder} />
  <button type="button" class="btn btn-subtle btn-icon btn-sm" data-password-toggle aria-label="Mostrar contraseña" aria-pressed="false">
    <i class="bi bi-eye" aria-hidden="true"></i>
  </button>
</div>
