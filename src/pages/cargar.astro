---
// Cargar datos (admin): productos, bodegas y saldo inicial desde Excel. Se copian las filas de Excel y se pegan,
// o se suelta un .csv. Primero se revisa fila por fila y luego se carga lo que esté bien.
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";

const tipos = [
  { id: "productos", label: "Productos", cols: ["Código", "Nombre", "Precio de venta", "Mínimo", "Unidad"], ejemplo: "LIB-003\tLibro de lectura\t50000\t20\tund" },
  { id: "bodegas", label: "Bodegas", cols: ["Nombre", "Ciudad", "País"], ejemplo: "Bodega Cali\tCali\tColombia" },
  { id: "saldo", label: "Saldo inicial", cols: ["Bodega", "Código", "Cantidad", "Costo unitario"], ejemplo: "Bodega Bogotá\tLIB-001\t50\t24000" },
];
---

<AppLayout title="Cargar datos">
  <PageHeader title="Cargar datos" subtitle="Desde Excel: copia las filas y pégalas aquí" />

  <div class="tabs" role="tablist" aria-label="Qué cargar">
    {tipos.map((t, i) => <button class="tab" role="tab" aria-selected={i === 0 ? "true" : "false"} data-tab={t.id}>{t.label}</button>)}
  </div>

  {
    tipos.map((t, i) => (
      <section class="card card-list carga" data-panel={t.id} data-carga={t.id} hidden={i > 0}>
        <div class="carga-head">
          <p class="muted small">
            Columnas en este orden: {t.cols.map((c, j) => <span class="badge">{j + 1}. {c}</span>)}
            {t.id === "saldo" && <span> · Entra como compra a «Saldo inicial» y fija el costo promedio.</span>}
            {t.id === "productos" && <span> · Si el código ya existe, se actualiza.</span>}
          </p>
          <button type="button" class="btn btn-ghost btn-sm" data-plantilla>
            <i class="bi bi-download" aria-hidden="true" />
            Plantilla
          </button>
        </div>
        <textarea class="textarea mono" rows="6" data-drop-text data-pegar placeholder={`Pega aquí las filas de Excel o suelta un archivo .csv\n\nEjemplo:\n${t.ejemplo.replaceAll("\t", "   ")}`} />
        <div class="table-wrap" data-revision hidden>
          <table class="table">
            <thead>
              <tr>
                <th class="num">Fila</th>
                {t.cols.map((c) => <th>{c}</th>)}
                <th>Resultado</th>
              </tr>
            </thead>
            <tbody data-rev-body />
          </table>
        </div>
        <div class="carga-foot">
          <span class="muted small" data-rev-resumen />
          <button type="button" class="btn btn-primary" data-cargar disabled>
            <i class="bi bi-upload" aria-hidden="true" />
            Cargar
          </button>
        </div>
      </section>
    ))
  }

  <script type="application/json" data-tipos set:html={JSON.stringify(tipos)} />
</AppLayout>

<style>
  .carga {
    gap: var(--space-3);
  }

  .carga-head,
  .carga-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .carga-head p {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
  }

  .mono {
    font-family: ui-monospace, Consolas, monospace;
    font-size: var(--text-xs);
    white-space: pre;
  }

  [data-revision] {
    max-height: 50dvh;
  }
</style>

<script>
  import "../lib/ui";
  import { cargarProductos, cargarBodegas, cargarSaldoInicial, llave, type Revision } from "../lib/store";
  import { esc, parseNum, descargarCsv } from "../lib/view";

  const tipos = JSON.parse(document.querySelector("[data-tipos]")!.textContent!) as { id: string; label: string; cols: string[]; ejemplo: string }[];

  /** Filas de lo pegado: Excel pega con tabulador; un .csv viene con «;» o «,». Quita la fila de títulos si la hay. */
  function leer(texto: string, cols: string[]) {
    const lineas = texto.split(/\r?\n/).filter((l) => l.trim());
    if (!lineas.length) return [];
    const sep = lineas[0]!.includes("\t") ? "\t" : lineas[0]!.includes(";") ? ";" : ",";
    const filas = lineas.map((l) => l.split(sep).map((c) => c.replace(/^"|"$/g, "").trim()));
    if (filas[0] && llave(filas[0][0] ?? "") === llave(cols[0]!)) filas.shift();
    return filas;
  }

  const revisar = (id: string, filas: string[][], guardar: boolean): Promise<Revision[]> =>
    id === "productos"
      ? cargarProductos(filas, parseNum, guardar)
      : id === "bodegas"
        ? cargarBodegas(filas, guardar)
        : cargarSaldoInicial(filas, parseNum, guardar);

  document.querySelectorAll<HTMLElement>("[data-carga]").forEach((card) => {
    const id = card.dataset.carga!;
    const tipo = tipos.find((t) => t.id === id)!;
    const area = card.querySelector<HTMLTextAreaElement>("[data-pegar]")!;
    const btn = card.querySelector<HTMLButtonElement>("[data-cargar]")!;
    const resumen = card.querySelector<HTMLElement>("[data-rev-resumen]")!;
    const tabla = card.querySelector<HTMLElement>("[data-revision]")!;

    const pintar = async () => {
      const filas = leer(area.value, tipo.cols);
      const rev = await revisar(id, filas, false);
      tabla.hidden = !rev.length;
      card.querySelector("[data-rev-body]")!.innerHTML = rev
        .map(
          (r) => `<tr ${r.ok ? "" : `data-tone="danger"`}>
            <td class="num tnum muted">${r.fila}</td>
            ${tipo.cols.map((_, j) => `<td>${esc(r.datos[j] ?? "")}</td>`).join("")}
            <td>${r.ok ? `<span class="dot success"></span> ${esc(r.estado)}` : `<span class="badge danger">${esc(r.estado)}</span>`}</td>
          </tr>`,
        )
        .join("");
      const buenas = rev.filter((r) => r.ok).length;
      const malas = rev.length - buenas;
      resumen.textContent = rev.length ? `${buenas} ${buenas === 1 ? "fila lista" : "filas listas"}${malas ? ` · ${malas} con error (no se cargan)` : ""}` : "";
      btn.disabled = !buenas;
      btn.lastChild!.textContent = buenas ? `Cargar ${buenas} ${buenas === 1 ? "fila" : "filas"}` : "Cargar";
    };
    area.addEventListener("input", pintar);

    btn.addEventListener("click", async () => {
      const filas = leer(area.value, tipo.cols);
      const ok = await window.ui.confirm({
        tone: "warning",
        title: `¿Cargar ${tipo.label.toLowerCase()}?`,
        message: "Se cargan solo las filas sin error. Si te equivocas, se corrige desde su pantalla (o anulando el movimiento).",
        confirmText: "Cargar",
      });
      if (!ok) return;
      await window.ui.busy(btn, async () => {
        try {
          const rev = await revisar(id, filas, true);
          window.ui.toast(`Listo: ${rev.filter((r) => r.ok).length} ${tipo.label.toLowerCase()} cargados`, { tone: "success" });
          area.value = "";
          await pintar();
        } catch (e) {
          window.ui.alert({ tone: "danger", title: "No se pudo cargar", message: e instanceof Error ? e.message : String(e) });
        }
      });
    });

    // Plantilla: archivo .csv con los títulos y una fila de ejemplo (Excel lo abre directo)
    card.querySelector("[data-plantilla]")!.addEventListener("click", () => {
      descargarCsv(`plantilla-${id}.csv`, [tipo.cols, tipo.ejemplo.split("\t")]);
    });
  });
</script>
