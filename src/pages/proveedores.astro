---
// Proveedores (admin): a quién se le compra, cuántas compras y cuánto.
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Modal from "../components/ui/Modal.astro";
import FormError from "../components/ui/FormError.astro";
---

<AppLayout title="Proveedores">
  <PageHeader title="Proveedores" subtitle=" ">
    <button slot="actions" type="button" class="btn btn-primary" data-new><i class="bi bi-plus-lg" aria-hidden="true"></i>Nuevo proveedor</button>
  </PageHeader>

  <section class="card card-list" data-table>
    <div class="toolbar">
      <label class="input-icon grow">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="input" type="search" placeholder="Buscar proveedor…" aria-label="Buscar" data-filter-q />
      </label>
    </div>
    <div class="table-wrap">
      <table class="table table-cards">
        <thead>
          <tr>
            <th data-sort="text" data-card-title>Proveedor</th>
            <th>Contacto</th>
            <th class="num" data-sort="num">Compras</th>
            <th class="num" data-sort="num">Comprado</th>
            <th data-sort="text">Última compra</th>
            <th></th>
          </tr>
        </thead>
        <tbody data-body></tbody>
      </table>
    </div>
    <div class="empty" data-empty hidden>
      <i class="bi bi-truck" aria-hidden="true"></i>
      <p class="muted">Ningún proveedor coincide.</p>
    </div>
  </section>

  <Modal id="prov-modal" title="Nuevo proveedor">
    <form class="form-grid" data-form novalidate>
      <div class="span-2"><FormError /></div>
      <div class="field span-2">
        <label for="pv-nombre">Nombre</label>
        <input id="pv-nombre" name="nombre" class="input" placeholder="Ej. Editorial Andina" />
      </div>
      <div class="field span-2">
        <label for="pv-contacto">Contacto</label>
        <input id="pv-contacto" name="contacto" class="input" placeholder="Teléfono o correo" />
      </div>
    </form>
    <button slot="footer" type="button" class="btn btn-ghost" data-modal-close>Cancelar</button>
    <button slot="footer" type="button" class="btn btn-primary" data-save>Guardar</button>
  </Modal>
</AppLayout>

<script>
  import "../lib/ui";
  import { initTableFilter } from "../lib/ui/table-filter";
  import { proveedores, proveedor, movimientos, totalMov, guardarProveedor } from "../lib/store";
  import { money, day, esc, searchText, menu, intentar, flashRow } from "../lib/view";

  const scope = document.querySelector<HTMLElement>("[data-table]")!;
  const body = scope.querySelector<HTMLElement>("[data-body]")!;
  const table = initTableFilter(scope);

  function render() {
    const compras = movimientos().filter((m) => m.tipo === "compra" && !m.anulado);
    const ps = proveedores();
    body.innerHTML = ps
      .map((p) => {
        const mias = compras.filter((c) => c.proveedor_id === p.id);
        const total = mias.reduce((a, c) => a + totalMov(c), 0);
        const ultima = mias[0]?.fecha ?? "";
        return `<tr data-row data-id="${p.id}" data-text="${esc(searchText(p.nombre, p.contacto))}">
          <td class="strong">${esc(p.nombre)}</td>
          <td class="muted">${esc(p.contacto || "—")}</td>
          <td class="num tnum">${mias.length}</td>
          <td class="num tnum" data-sort-value="${total}">${money(total)}</td>
          <td class="nowrap" data-sort-value="${ultima}">${ultima ? day(ultima) : '<span class="muted">—</span>'}</td>
          <td class="cell-actions">${menu([{ value: "editar", label: "Editar", icon: "bi-pencil" }, { value: "compras", label: "Ver compras", icon: "bi-bag" }])}</td>
        </tr>`;
      })
      .join("");
    document.querySelector("[data-page-subtitle]")!.textContent = `${ps.length} ${ps.length === 1 ? "proveedor" : "proveedores"}`;
    table.rescan();
  }
  render();

  const modal = document.getElementById("prov-modal")!;
  const form = modal.querySelector<HTMLFormElement>("[data-form]")!;
  const field = (n: string) => form.querySelector<HTMLInputElement>(`[name=${n}]`)!;
  let editando = "";
  function open(id = "") {
    editando = id;
    const p = id ? proveedor(id) : undefined;
    intentar(form, () => {});
    modal.querySelector("[data-modal-title]")!.textContent = p ? `Editar ${p.nombre}` : "Nuevo proveedor";
    field("nombre").value = p?.nombre ?? "";
    field("contacto").value = p?.contacto ?? "";
    window.ui.openModal("prov-modal");
    field("nombre").focus();
  }
  document.querySelector("[data-new]")!.addEventListener("click", () => open());
  modal.querySelector("[data-save]")!.addEventListener("click", async () => {
    let id = "";
    const ok = await intentar(form, async () => (id = (await guardarProveedor({ id: editando || undefined, nombre: field("nombre").value, contacto: field("contacto").value })).id), editando ? "Proveedor actualizado" : "Proveedor creado");
    if (!ok) return;
    window.ui.closeModal("prov-modal");
    render();
    flashRow(body.querySelector(`tr[data-id="${id}"]`));
  });
  body.addEventListener("menu-select", (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>("tr[data-id]")!.dataset.id!;
    const { value } = (e as CustomEvent<{ value: string }>).detail;
    if (value === "editar") open(id);
    if (value === "compras") location.href = `/movimientos?q=${encodeURIComponent(proveedor(id)!.nombre.toLowerCase())}`;
  });
</script>
