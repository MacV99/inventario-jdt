---
// Métodos de pago (admin, pedido de Leidy 2026-11-09): cómo paga el cliente (efectivo, Nequi, tarjeta…).
// Se pueden agregar, renombrar y desactivar (los desactivados dejan de salir al vender; las ventas viejas los conservan).
// Cada uno es de un país (al vender solo salen los del país de donde sale la venta); sin país = sirve en todos.
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Modal from "../components/ui/Modal.astro";
import FormError from "../components/ui/FormError.astro";
import Select from "../components/ui/Select.astro";
---

<AppLayout title="Métodos de pago">
  <PageHeader title="Métodos de pago" subtitle=" ">
    <button slot="actions" type="button" class="btn btn-primary" data-new><i class="bi bi-plus-lg" aria-hidden="true"></i>Nuevo método</button>
  </PageHeader>

  <section class="card card-list" data-table>
    <div class="table-wrap">
      <table class="table table-cards">
        <thead>
          <tr>
            <th data-sort="text" data-card-title>Método</th>
            <th data-sort="text">País</th>
            <th class="num" data-sort="num">Ventas</th>
            <th class="num" data-sort="num">Vendido</th>
            <th data-sort="text">Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody data-body></tbody>
      </table>
    </div>
    <div class="empty" data-empty hidden>
      <i class="bi bi-credit-card" aria-hidden="true"></i>
      <p class="muted">Aún no hay métodos de pago.</p>
    </div>
  </section>

  <Modal id="metodo-modal" title="Nuevo método de pago">
    <form class="form-grid" data-form novalidate>
      <div class="span-2"><FormError /></div>
      <div class="field span-2">
        <label for="mp-nombre">Nombre</label>
        <input id="mp-nombre" name="nombre" class="input" placeholder="Ej. Tarjeta Visa · Datáfono Bancolombia" />
      </div>
      <div class="field span-2">
        <span class="label">País</span>
        <Select name="pais" searchable label="País" options={[]} />
        <span class="hint">«Todos los países» si sirve en cualquiera (p. ej. Efectivo).</span>
      </div>
    </form>
    <button slot="footer" type="button" class="btn btn-ghost" data-modal-close>Cancelar</button>
    <button slot="footer" type="button" class="btn btn-primary" data-save>Guardar</button>
  </Modal>
</AppLayout>

<script>
  import "../lib/ui";
  import { initTableFilter } from "../lib/ui/table-filter";
  import { metodosPago, metodoPago, ventas, totalMov, guardarMetodoPago, paises, paisActual } from "../lib/store";
  import { money, esc, menu, intentar, flashRow, dsSelect } from "../lib/view";

  const scope = document.querySelector<HTMLElement>("[data-table]")!;
  const body = scope.querySelector<HTMLElement>("[data-body]")!;
  const table = initTableFilter(scope);

  function render() {
    const vs = ventas();
    const ms = metodosPago();
    body.innerHTML = ms
      .map((m) => {
        const mias = vs.filter((v) => v.metodo_pago_id === m.id);
        const total = mias.reduce((a, v) => a + totalMov(v), 0);
        return `<tr data-row data-id="${m.id}">
          <td class="strong">${esc(m.nombre)}</td>
          <td>${m.pais ? esc(m.pais) : '<span class="muted">Todos</span>'}</td>
          <td class="num tnum">${mias.length}</td>
          <td class="num tnum" data-sort-value="${total}">${money(total)}</td>
          <td>${m.activo ? '<span class="dot success"></span> Activo' : '<span class="badge">Desactivado</span>'}</td>
          <td class="cell-actions">${menu([
            { value: "editar", label: "Editar", icon: "bi-pencil" },
            m.activo ? { value: "desactivar", label: "Desactivar", icon: "bi-slash-circle" } : { value: "activar", label: "Activar", icon: "bi-check2" },
          ])}</td>
        </tr>`;
      })
      .join("");
    document.querySelector("[data-page-subtitle]")!.textContent = `${ms.filter((m) => m.activo).length} activos`;
    table.rescan();
  }
  render();

  const modal = document.getElementById("metodo-modal")!;
  const form = modal.querySelector<HTMLFormElement>("[data-form]")!;
  const nombre = form.querySelector<HTMLInputElement>("[name=nombre]")!;
  const pais = dsSelect(form, "ds-select[name=pais]");
  pais.setOptions([{ value: "", label: "Todos los países" }, ...paises().map((p) => ({ value: p.nombre, label: p.nombre }))]);
  let editando = 0;
  function open(id = 0) {
    editando = id;
    intentar(form, () => {});
    const m = id ? metodoPago(id) : undefined;
    modal.querySelector("[data-modal-title]")!.textContent = m ? `Editar ${m.nombre}` : "Nuevo método de pago";
    nombre.value = m?.nombre ?? "";
    pais.value = m ? m.pais ?? "" : paisActual();
    window.ui.openModal("metodo-modal");
    nombre.focus();
  }
  document.querySelector("[data-new]")!.addEventListener("click", () => open());
  modal.querySelector("[data-save]")!.addEventListener("click", async () => {
    let id = 0;
    const ok = await intentar(form, async () => (id = await guardarMetodoPago({ id: editando || undefined, nombre: nombre.value, pais: pais.value })), editando ? "Método actualizado" : "Método creado");
    if (!ok) return;
    window.ui.closeModal("metodo-modal");
    render();
    flashRow(body.querySelector(`tr[data-id="${id}"]`));
  });
  body.addEventListener("menu-select", async (e) => {
    const id = Number((e.target as HTMLElement).closest<HTMLElement>("tr[data-id]")!.dataset.id);
    const { value } = (e as CustomEvent<{ value: string }>).detail;
    if (value === "editar") return open(id);
    const activo = value === "activar";
    if (!activo) {
      const ok = await window.ui.confirm({ tone: "warning", title: `¿Desactivar ${metodoPago(id)?.nombre ?? "este método"}?`, message: "Deja de salir al vender. Las ventas viejas lo conservan. Se puede activar de nuevo.", confirmText: "Desactivar" });
      if (!ok) return;
    }
    if (await intentar(null, () => guardarMetodoPago({ id, activo }), activo ? "Método activado" : "Método desactivado: ya no sale al vender")) {
      render();
      flashRow(body.querySelector(`tr[data-id="${id}"]`));
    }
  });
</script>
