---
// Resumen (admin): del país elegido, cifras del mes, productos por bodega, por agotarse y últimos movimientos.
// En global (sin país): solo una fila corta por país.
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import StatCard from "../components/ui/StatCard.astro";
---

<AppLayout title="Resumen">
  <PageHeader title="Resumen" subtitle=" ">
    <a slot="actions" href="/movimientos?nuevo" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Nuevo movimiento</a>
  </PageHeader>

  <!-- Global (sin país elegido): pocos datos, uno por país -->
  <section class="card card-list" data-global hidden>
    <div class="card-title">
      <h2 class="caps">Por país</h2>
      <span class="muted small">Elige un país en el menú para ver todo</span>
    </div>
    <div class="table-wrap">
      <table class="table tabla-paises">
        <thead>
          <tr><th>País</th><th class="num">Productos</th><th class="num">Bodegas</th><th class="num">Vendido este mes</th></tr>
        </thead>
        <tbody data-paises></tbody>
      </table>
    </div>
  </section>

  <section class="card kpis" data-kpis data-local>
    <StatCard label="Productos" value="—" dataKey="unidades" hint="Todo lo que hay en bodegas y maletas" />
    <StatCard label="Vendido este mes" value="—" dataKey="vendido" />
    <StatCard label="Por recibir" value="—" dataKey="debe" hint="Dinero de ventas que los monitores no han entregado" />
  </section>

  <div class="grid-2" data-local>
    <section class="card card-list">
      <div class="card-title">
        <h2 class="caps">Productos por bodega</h2>
        <a href="/inventario" class="small">Ver inventario</a>
      </div>
      <div class="hbars" data-bars></div>
    </section>

    <section class="card card-list">
      <div class="card-title">
        <h2 class="caps">Por agotarse</h2>
        <span class="muted small">Bajo el mínimo, en bodegas</span>
      </div>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Producto</th><th>Bodega</th><th class="num">Quedan</th><th class="num">Mínimo</th></tr>
          </thead>
          <tbody data-low></tbody>
        </table>
      </div>
      <div class="empty" data-low-empty hidden>
        <i class="bi bi-check2-circle" aria-hidden="true"></i>
        <p class="muted">Nada por agotarse.</p>
      </div>
    </section>
  </div>

  <section class="card card-list" data-local>
    <div class="card-title">
      <h2 class="caps">Últimos movimientos</h2>
      <a href="/movimientos" class="small">Ver todos</a>
    </div>
    <div class="table-wrap">
      <table class="table table-cards">
        <thead>
          <tr><th data-card-title>N.º</th><th>Fecha</th><th>Tipo</th><th>De → A</th><th class="num">Unidades</th><th class="num">Valor</th></tr>
        </thead>
        <tbody data-last></tbody>
      </table>
    </div>
  </section>
</AppLayout>

<style>
  .grid-2 {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--page-gap);
  }

  @media (min-width: 1100px) {
    .grid-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .card-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  /* Celular: sin la columna de bodegas para que se vea lo vendido */
  @media (max-width: 599.98px) {
    .tabla-paises :global(:is(th, td):nth-child(3)) {
      display: none;
    }

    .tabla-paises th {
      white-space: normal;
    }
  }

  [data-paises] :global(.fila-total td) {
    border-top: 1px solid var(--clr-border-strong, var(--clr-border));
    font-weight: 700;
  }

  .hbars :global(.hbar) {
    grid-template-columns: minmax(0, 170px) minmax(40px, 1fr) auto;
    color: inherit;
    border-radius: var(--radius-sm);
  }

  .hbars :global(.hbar .sub) {
    display: block;
  }

  @media (hover: hover) {
    .hbars :global(a.hbar:hover) {
      background-color: var(--clr-surface-hover);
    }
  }
</style>

<script>
  import { setKpi } from "../lib/ui/kpi";
  import { bodegas, productos, stockFilas, ventas, totalMov, cuadre, movimientos, unidadesMov, rutaMov, paises, paisActual, elegirPais, TIPO_MOV } from "../lib/store";
  import { money, num, day, esc, monthLabel, today } from "../lib/view";

  const mes = today().slice(0, 7);
  const elegido = paisActual();
  document.querySelector("[data-page-subtitle]")!.textContent = `${elegido || "Global"} · ${monthLabel(mes)}`;

  // Global: una fila por país (productos, bodegas y lo vendido este mes en pesos)
  if (!elegido) {
    document.querySelector<HTMLElement>("[data-global]")!.hidden = false;
    document.querySelectorAll<HTMLElement>("[data-local]").forEach((el) => (el.hidden = true));
    const fs = stockFilas();
    const vs = ventas().filter((v) => v.fecha.startsWith(mes));
    const filasPais = paises().map((p) => {
      const ids = new Set(bodegas().filter((b) => b.pais === p.nombre).map((b) => b.id));
      return {
        nombre: p.nombre,
        unidades: fs.filter((f) => ids.has(f.bodega_id)).reduce((a, f) => a + f.cantidad, 0),
        bodegas: bodegas().filter((b) => b.pais === p.nombre && b.tipo === "bodega" && b.activa).length,
        vendido: vs.filter((v) => ids.has(v.origen_id ?? "")).reduce((a, v) => a + totalMov(v), 0),
      };
    });
    const suma = (k: "unidades" | "bodegas" | "vendido") => filasPais.reduce((a, x) => a + x[k], 0);
    document.querySelector("[data-paises]")!.innerHTML = filasPais
      .map(
        (x) => `<tr>
          <td><a href="/" class="strong" data-ir-pais="${esc(x.nombre)}">${esc(x.nombre)}</a></td>
          <td class="num tnum strong">${num(x.unidades)}</td>
          <td class="num tnum">${num(x.bodegas)}</td>
          <td class="num tnum">${money(x.vendido)}</td>
        </tr>`,
      )
      .join("") + `<tr class="fila-total"><td class="strong">Total</td><td class="num tnum strong">${num(suma("unidades"))}</td><td class="num tnum">${num(suma("bodegas"))}</td><td class="num tnum">${money(suma("vendido"))}</td></tr>`;
    document.querySelector("[data-paises]")!.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>("[data-ir-pais]");
      if (!b) return;
      e.preventDefault();
      elegirPais(b.dataset.irPais!);
      location.reload();
    });
  }

  const filas = stockFilas();
  const kpis = document.querySelector<HTMLElement>("[data-kpis]")!;
  const delMes = ventas().filter((v) => v.fecha.startsWith(mes));
  const vendido = delMes.reduce((a, v) => a + totalMov(v), 0);
  const debe = cuadre().reduce((a, c) => a + Math.max(0, c.debeBase), 0);
  setKpi(kpis, "unidades", num(filas.reduce((a, f) => a + f.cantidad, 0)));
  setKpi(kpis, "vendido", money(vendido), `${delMes.length} ${delMes.length === 1 ? "venta" : "ventas"}`);
  setKpi(kpis, "debe", money(debe), "de monitores");

  // Productos por bodega (bodegas primero, luego maletas)
  const porBodega = bodegas()
    .filter((b) => b.activa)
    .map((b) => ({ b, valor: filas.filter((f) => f.bodega_id === b.id).reduce((a, f) => a + f.cantidad, 0) }))
    .sort((a, b) => (a.b.tipo === b.b.tipo ? b.valor - a.valor : a.b.tipo === "bodega" ? -1 : 1));
  const max = Math.max(1, ...porBodega.map((x) => x.valor));
  document.querySelector("[data-bars]")!.innerHTML = porBodega
    .map(
      (x) => `<a class="hbar" href="/inventario?ubicacion=${x.b.id}">
        <span>${esc(x.b.nombre)}<span class="sub">${x.b.tipo === "monitor" ? "Maleta" : `${esc(x.b.ciudad)} · ${esc(x.b.pais)}`}</span></span>
        <span class="hbar-track"><span style="width:${(x.valor / max) * 100}%"></span></span>
        <span class="tnum">${num(x.valor)}</span>
      </a>`,
    )
    .join("");

  // Por agotarse: en cada bodega, lo que está bajo el mínimo del producto. También lo que ya se acabó,
  // pero solo donde alguna vez hubo (una bodega que nunca manejó ese producto no avisa).
  const hubo = new Set(movimientos().filter((m) => !m.anulado && m.destino_id).flatMap((m) => m.items.map((i) => `${m.destino_id}|${i.producto_id}`)));
  const low = bodegas()
    .filter((b) => b.tipo === "bodega" && b.activa)
    .flatMap((b) =>
      productos()
        .filter((p) => p.activo)
        .map((p) => ({ b, p, cantidad: filas.find((f) => f.bodega_id === b.id && f.producto_id === p.id)?.cantidad ?? 0 })),
    )
    .filter((x) => x.cantidad < x.p.stock_minimo && (x.cantidad > 0 || hubo.has(`${x.b.id}|${x.p.id}`)))
    .sort((a, b) => a.cantidad / a.p.stock_minimo - b.cantidad / b.p.stock_minimo);
  document.querySelector("[data-low]")!.innerHTML = low
    .map(
      (x) => `<tr data-tone="${x.cantidad < x.p.stock_minimo / 2 ? "danger" : "warning"}">
        <td class="strong">${esc(x.p.nombre)}</td><td>${esc(x.b.nombre)}</td>
        <td class="num tnum">${num(x.cantidad)}</td><td class="num tnum muted">${num(x.p.stock_minimo)}</td>
      </tr>`,
    )
    .join("");
  document.querySelector<HTMLElement>("[data-low-empty]")!.hidden = low.length > 0;

  // Últimos movimientos
  document.querySelector("[data-last]")!.innerHTML = movimientos()
    .slice(0, 5)
    .map((m) => {
      const t = TIPO_MOV[m.tipo];
      const { de, a } = rutaMov(m);
      return `<tr class="${m.anulado ? "anulado" : ""}">
        <td class="tnum strong"><a href="/movimientos?ver=${m.id}">#${m.id}</a></td>
        <td class="nowrap">${day(m.fecha)}</td>
        <td class="nowrap"><i class="bi ${t.icon} muted" aria-hidden="true"></i> ${t.label}${m.anulado ? ' <span class="badge danger">Anulado</span>' : ""}</td>
        <td>${esc(de)} <span class="muted">→</span> ${esc(a)}</td>
        <td class="num tnum">${num(unidadesMov(m))}</td>
        <td class="num tnum">${m.tipo === "venta" ? money(totalMov(m)) : '<span class="muted">—</span>'}</td>
      </tr>`;
    })
    .join("");
</script>
