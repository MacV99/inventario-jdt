---
// Inventario (admin): arriba solo cuántos productos hay en total; al elegir país o bodega sale el detalle.
// Sin precios por ahora. Se abre filtrado con ?ubicacion=<id> (desde Resumen o Bodegas).
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Select from "../components/ui/Select.astro";
import Modal from "../components/ui/Modal.astro";
import FormError from "../components/ui/FormError.astro";
---

<AppLayout title="Inventario">
  <PageHeader title="Inventario" subtitle="Cuántos productos hay">
    <button slot="actions" type="button" class="btn btn-ghost" data-conteo><i class="bi bi-clipboard-check" aria-hidden="true"></i>Contar una bodega</button>
    <a slot="actions" href="/movimientos?nuevo" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Nuevo movimiento</a>
  </PageHeader>

  <section class="card card-list" data-table>
    <div class="total">
      <p class="caps">Productos en total</p>
      <p class="total-num tnum" data-total>—</p>
      <p class="muted small" data-total-sub></p>
    </div>
    <div class="toolbar">
      <Select value="" searchable filter="pais" label="País" options={[{ value: "", label: "Todos los países" }]} id="f-pais" />
      <Select value="" searchable filter="ubicacion" label="Bodega" options={[{ value: "", label: "Todas las bodegas" }]} id="f-ubicacion" />
      <label class="input-icon grow">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="input" type="search" placeholder="Buscar producto…" aria-label="Buscar" data-filter-q />
      </label>
    </div>
    <p class="muted small" data-pide>Elige un país o una bodega para ver el detalle.</p>
    <div class="table-wrap" data-detalle hidden>
      <table class="table table-cards">
        <thead>
          <tr>
            <th data-sort="text" data-card-title>Producto</th>
            <th data-sort="text">Bodega</th>
            <th class="num" data-sort="num">Cantidad</th>
          </tr>
        </thead>
        <tbody data-body></tbody>
      </table>
    </div>
    <div class="empty" data-empty hidden>
      <i class="bi bi-box-seam" aria-hidden="true"></i>
      <p class="muted">Nada coincide con el filtro.</p>
    </div>
  </section>

  <!-- Conteo físico: se escribe lo que hay de verdad y las diferencias quedan como ajustes -->
  <Modal id="conteo-modal" title="Contar una bodega" description="Escribe lo que contaste. Lo que dejes vacío no cambia." size="lg">
    <div class="conteo">
      <FormError />
      <div class="field">
        <span class="label">Bodega o maleta</span>
        <Select searchable placeholder="Elegir" options={[]} id="c-bodega" />
      </div>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Producto</th><th class="num">Sistema</th><th class="num">Contado</th><th class="num">Diferencia</th></tr></thead>
          <tbody data-c-body></tbody>
        </table>
      </div>
      <div class="field">
        <label for="c-nota">Nota</label>
        <input id="c-nota" class="input" placeholder="Ej. Conteo de fin de mes" />
      </div>
      <p class="muted small" data-c-resumen></p>
    </div>
    <button slot="footer" type="button" class="btn btn-ghost" data-modal-close>Cancelar</button>
    <button slot="footer" type="button" class="btn btn-primary" data-c-save>Guardar conteo</button>
  </Modal>
</AppLayout>

<style>
  .total {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-2) 0 var(--space-4);
  }

  .total-num {
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1.1;
  }

  .conteo {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .conteo :global(.contado) {
    width: 90px;
    height: var(--control-h-sm);
    margin-left: auto;
    text-align: right;
  }
</style>

<script>
  import "../lib/ui";
  import { initTableFilter } from "../lib/ui/table-filter";
  import { bodegas, productos, stockFilas, bodega, producto, cantidadEn, guardarConteo, paisActual } from "../lib/store";
  import { num, esc, searchText, uniqueOptions, dsSelect, urlParam, intentar, parseNum, opcionesLugar } from "../lib/view";

  const filas = stockFilas().map((f) => ({ ...f, b: bodega(f.bodega_id)!, p: producto(f.producto_id)! }));
  const scope = document.querySelector<HTMLElement>("[data-table]")!;
  const bs = bodegas().filter((b) => b.activa);
  const fPais = dsSelect(scope, "#f-pais");
  const fUbicacion = dsSelect(scope, "#f-ubicacion");

  // Filtros: país (solo en global) y bodega (las del país elegido)
  fPais.setOptions([{ value: "", label: "Todos los países" }, ...uniqueOptions(bs.map((b) => b.pais))]);
  const opcionesBodega = (p = "") => fUbicacion.setOptions([{ value: "", label: "Todas las bodegas" }, ...opcionesLugar(bs.filter((b) => !p || b.pais === p), !p && !paisActual())]);
  opcionesBodega();

  scope.querySelector("[data-body]")!.innerHTML = filas
    .sort((a, b) => (a.b.tipo === b.b.tipo ? a.b.nombre.localeCompare(b.b.nombre) || a.p.nombre.localeCompare(b.p.nombre) : a.b.tipo === "bodega" ? -1 : 1))
    .map(
      (f) => `<tr data-row data-pais="${esc(f.b.pais)}" data-ubicacion="${f.b.id}" data-cantidad="${f.cantidad}" data-text="${esc(searchText(f.p.nombre, f.p.codigo))}">
        <td><span class="strong">${esc(f.p.nombre)}</span><p class="sub">${esc(f.p.codigo)}</p></td>
        <td>${esc(f.b.nombre)}<p class="sub">${f.b.tipo === "monitor" ? "Maleta" : esc([f.b.ciudad, f.b.pais].filter(Boolean).join(" · "))}</p></td>
        <td class="num tnum strong" data-sort-value="${f.cantidad}">${num(f.cantidad)}</td>
      </tr>`,
    )
    .join("");

  // Arriba solo el total; el detalle sale al elegir país, bodega o buscar
  const detalle = scope.querySelector<HTMLElement>("[data-detalle]")!;
  const pide = scope.querySelector<HTMLElement>("[data-pide]")!;
  const empty = scope.querySelector<HTMLElement>("[data-empty]")!;
  const conPais = !!paisActual();
  if (conPais) pide.textContent = "Elige una bodega para ver el detalle.";
  const table = initTableFilter(scope, ({ visible, active, query, changed }) => {
    if (changed === "pais") {
      opcionesBodega(active.pais);
      if (fUbicacion.value) table.set("ubicacion", "");
    }
    const unidades = visible.reduce((a, r) => a + Number(r.dataset.cantidad), 0);
    scope.querySelector("[data-total]")!.textContent = num(unidades);
    const lugares = new Set(visible.map((r) => r.dataset.ubicacion)).size;
    scope.querySelector("[data-total-sub]")!.textContent = `${lugares === 1 ? "En 1 bodega" : `En ${num(lugares)} bodegas y maletas`}${paisActual() || active.pais ? ` · ${paisActual() || active.pais}` : ""}`;
    const ver = !!(active.pais || active.ubicacion || query);
    detalle.hidden = !ver || !visible.length;
    pide.hidden = ver;
    if (!ver) empty.hidden = true;
  });
  table.rescan();
  const desde = urlParam("ubicacion");
  if (desde) table.set("ubicacion", desde);

  // ── Conteo físico ──
  const cm = document.getElementById("conteo-modal")!;
  const cBodega = dsSelect(cm, "#c-bodega");
  const cBody = cm.querySelector<HTMLElement>("[data-c-body]")!;
  const cResumen = cm.querySelector<HTMLElement>("[data-c-resumen]")!;
  function pintarConteo() {
    const b = cBodega.value;
    cBody.innerHTML = b
      ? productos()
          .filter((p) => p.activo)
          .map((p) => {
            const hay = cantidadEn(b, p.id);
            return `<tr data-c-prod="${p.id}" data-hay="${hay}">
              <td class="strong">${esc(p.nombre)}<p class="sub">${esc(p.codigo)}</p></td>
              <td class="num tnum">${num(hay)}</td>
              <td class="num"><input class="input tnum contado" type="text" inputmode="numeric" aria-label="Contado de ${esc(p.nombre)}" /></td>
              <td class="num tnum" data-dif></td>
            </tr>`;
          })
          .join("")
      : "";
    recalcConteo();
  }
  function recalcConteo() {
    let sobra = 0;
    let falta = 0;
    cBody.querySelectorAll<HTMLElement>("tr").forEach((tr) => {
      const v = tr.querySelector<HTMLInputElement>("input")!.value.trim();
      const d = v === "" ? 0 : parseNum(v) - Number(tr.dataset.hay);
      tr.querySelector("[data-dif]")!.innerHTML = v === "" || d === 0 ? (v === "" ? "" : '<span class="muted">Coincide</span>') : `<span class="badge ${d > 0 ? "warning" : "danger"}">${d > 0 ? "+" : "−"}${num(Math.abs(d))}</span>`;
      if (d > 0) sobra += d;
      if (d < 0) falta -= d;
    });
    cResumen.textContent = sobra || falta ? `Sobran ${num(sobra)} y faltan ${num(falta)} unidades. Se guardan como ajustes.` : "";
  }
  cBodega.addEventListener("change", pintarConteo);
  cBody.addEventListener("input", recalcConteo);
  document.querySelector("[data-conteo]")!.addEventListener("click", () => {
    intentar(cm, () => {});
    cBodega.setOptions(opcionesLugar(bodegas().filter((b) => b.activa)));
    cBodega.value = urlParam("ubicacion");
    (cm.querySelector("#c-nota") as HTMLInputElement).value = "";
    pintarConteo();
    window.ui.openModal("conteo-modal");
  });
  cm.querySelector("[data-c-save]")!.addEventListener("click", async () => {
    if (!cBodega.value) return intentar(cm, () => { throw new Error("Elige la bodega que contaste."); });
    const conteo = [...cBody.querySelectorAll<HTMLElement>("tr")]
      .map((tr) => ({ producto_id: tr.dataset.cProd!, valor: tr.querySelector<HTMLInputElement>("input")!.value.trim() }))
      .filter((c) => c.valor !== "")
      .map((c) => ({ producto_id: c.producto_id, contado: parseNum(c.valor) }));
    if (!conteo.length) return intentar(cm, () => { throw new Error("Escribe al menos una cantidad contada."); });
    let ids = "";
    const ok = await intentar(
      cm,
      async () => {
        ids = (await guardarConteo(cBodega.value, conteo, (cm.querySelector("#c-nota") as HTMLInputElement).value)).map((m) => `#${m.id}`).join(" y ");
      },
      undefined,
      cm.querySelector<HTMLElement>("[data-c-save]"),
    );
    if (!ok) return;
    window.ui.flash(`Conteo guardado: ajustes ${ids}`, "success");
    location.reload();
  });
</script>
